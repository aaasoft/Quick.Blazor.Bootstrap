@inherits ComponentBase_WithGettextSupport;

<div class="card-body small p-0">
    @if (IsLoading)
    {
        <div class="spinner-border" role="status">
            <span class="sr-only">Loading...</span>
        </div>
    }
    else
    {
        <div class="m-2">
            <div class="btn-group" role="group" aria-label="BasicButtons">
                <button type="button" class="btn btn-sm btn-secondary" @onclick="RefreshProcess">
                    @TextRefresh
                </button>
            </div>
        </div>
        <table class="table table-sm table-striped table-borderless table-hover mb-0" style="overflow-wrap: anywhere;">
            <tbody>
                @if (processModules != null)
                {
                    <tr>
                        <th>@TextColumnModuleName</th>
                        <th>@TextColumnFileName</th>
                        <th>@TextColumnFileVersion</th>
                        <th>@TextColumnModuleMemorySize</th>
                    </tr>
                    @foreach (var module in processModules)
                    {
                        <tr>
                            <td>@module.ModuleName</td>
                            <td>@module.FileName</td>
                            <td>@getFileVersion(module)</td>
                            <td>@(storageUSC.GetString(module.ModuleMemorySize, 2, true) + "B")</td>
                        </tr>
                    }
                }
                @if (!string.IsNullOrEmpty(ExceptionString))
                {
                    <tr>
                        <td>@ExceptionString</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>